# Copy to .env and adjust. Both `make` and `docker compose` read it.
#   cp .env.example .env

# Host port the backend is published on.
STRATUS_PORT=8080

# Host directory holding photos, music, calendars and the SQLite database.
# Point this at real storage for anything you intend to keep.
STRATUS_DATA_PATH=./data

# User the container runs as. It must own STRATUS_DATA_PATH; `make up` defaults
# these to the invoking user, so only set them for a dedicated service account.
#STRATUS_UID=1000
#STRATUS_GID=1000

# debug | info | warn | error
STRATUS_LOG_LEVEL=info

# Blob storage. The scheme selects the backend. Unset means <data path>/blobs on
# disk, which is what the compose setup above already mounts.
#STRATUS_STORAGE_DSN=file:///data/blobs
#STRATUS_STORAGE_DSN=s3://KEY:SECRET@s3.eu-west-1.amazonaws.com/bucket?region=eu-west-1
# For a MinIO on your own network, turn TLS off explicitly:
#STRATUS_STORAGE_DSN=s3://KEY:SECRET@minio.lan:9000/stratus?tls=false

# Metadata database. The scheme selects the driver. Unset means a SQLite file
# next to the blobs, which is the right answer for a personal instance.
#STRATUS_DB_DSN=sqlite:///data/stratus.db
#STRATUS_DB_DSN=postgres://user:pass@db.lan:5432/stratus?sslmode=require
# SQLite takes no parameters: the pragmas Stratus needs are not optional and are
# set for you.

# The single user. Both or neither: half-set credentials refuse to start.
# The password is held as configured, not hashed: OpenSubsonic's token auth is
# md5(password + salt) and a hash cannot produce it.
#STRATUS_USERNAME=edu
#STRATUS_PASSWORD=
